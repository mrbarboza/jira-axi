{
  "name": "jira-axi",
  "version": "0.1.0-alfa",
  "description": "AXI-style CLI for Jira Cloud — token-efficient TOON output, pre-computed aggregates, read-only v1",
  "type": "module",
  "bin": {
    "jira-axi": "./dist/bin/jira-axi.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "compile": "tsc",
    "dev": "tsx bin/jira-axi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "jira",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "dependencies": {
    "@toon-format/toon": "^2.3.0",
    "axi-sdk-js": "^0.1.8",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
